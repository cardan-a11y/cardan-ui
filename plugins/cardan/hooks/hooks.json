{
  "description": "The Cardan local review: git commit, git push and gh pr create are blocked until the cardan:cardan-reviewer agent (or the cardan:plugin-reviewer, for a change to the Claude Code setup alone) has reviewed the working tree as it is, and the shared guidelines are added to every session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cardan-review.mjs\" guidelines",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cardan-review.mjs\" gate",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^cardan:(cardan|plugin)-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cardan-review.mjs\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^cardan:(cardan|plugin)-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cardan-review.mjs\" mark",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
