{
  "name": "@cardan/ui",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "version": "2.5.0",
  "main": "./nuxt.config.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardan-a11y/cardan-ui.git"
  },
  "scripts": {
    "dev": "nuxi dev .playground  --public",
    "dev:prepare": "nuxt prepare .playground",
    "build": "nuxt build .playground",
    "generate": "nuxt generate .playground",
    "preview": "nuxt preview .playground",
    "postinstall": "nuxt prepare .playground",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p .playground/.nuxt/tsconfig.app.json",
    "test": "vitest run",
    "test:browser": "playwright test -c test/browser",
    "test:projects": "node test/projects.mjs",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.97",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/vscode-icons": "^1.2.95",
    "@mdit/plugin-attrs": "^1.4.0",
    "@mdit/plugin-mark": "^2.1.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/image": "^2.2.1",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/html-validator": "^2.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@vue/test-utils": "^2.5.1",
    "@vueform/multiselect": "^2.6.11",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "axe-core": "^4.14.0",
    "compressorjs": "^1.4.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "md-editor-v3": "^7.1.0",
    "nuxt": "4.6.4",
    "nuxt-auth-sanctum": "^3.1.5",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.44",
    "vue-axe": "^3.1.2",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
